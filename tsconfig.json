{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist/types",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "module": "es6",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist/esm",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "stripInternal": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["test/**/*"],
  "include": ["src"]
}
